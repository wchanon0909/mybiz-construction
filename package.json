{
  "name": "mybiz-construction",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real project finance app for Cloudflare Pages, D1, R2 and Google Drive",
  "scripts": {
    "build": "node scripts/check.mjs && node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "npx wrangler pages dev public --d1=DB --r2=FILES --persist-to=.wrangler/state",
    "db:local": "npx wrangler d1 execute mybiz-db --local --file=migrations/0001_init.sql",
    "db:remote": "npx wrangler d1 execute mybiz-db --remote --file=migrations/0001_init.sql"
  }
}
